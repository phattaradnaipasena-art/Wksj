    for i, data in ipairs(buttonList) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0.95, 0, 0, 40)
        btn.Position = UDim2.new(0.025, 0, 0, (i-1)*43)
        btn.BackgroundColor3 = Color3.fromRGB(40, 40, 65)
