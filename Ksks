-- ================================================================
--  ฟังก์ชัน ESP (ใช้ BillboardGui ให้ทุกคนเห็นผล)
-- ================================================================
local function toggleESP()
    state.ESP = not state.ESP
    btnESP.Text = state.ESP and "🟢 ESP (แตะปิด)" or "🔴 ESP (แตะเปิด)"

    if state.ESP then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                spawnESP(player)
            end
        end
    else
        for _, v in pairs(espBillboards) do
            pcall(function() v:Destroy() end)
        end
        espBillboards = {}
    end
end

function spawnESP(player)
    if espBillboards[player] then return end
    if not player.Character then return end
    local head = player.Character:FindFirstChild("Head")
    if not head then return end

    -- BillboardGui ที่ทุกคนในเซิร์ฟเวอร์มองเห็นได้
    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 250, 0, 60)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = 1000
    billboard.Parent = head

    -- พื้นหลังชื่อ
    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, 0, 1, 0)
    bg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    bg.BackgroundTransparency = 0.5
    bg.BorderSizePixel = 1
    bg.BorderColor3 = Color3.fromRGB(255, 50, 200)
    bg.Parent = billboard

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = player.Name
    label.TextColor3 = Color3.fromRGB(255, 255, 100)
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.TextStrokeTransparency = 0.2
    label.Parent = billboard

    espBillboards[player] = billboard

    -- อัปเดตระยะทาง
    task.spawn(function()
        while state.ESP and espBillboards[player] and player.Character do
            task.wait(0.3)
            local dist = (head.Position - Camera.CFrame.Position).Magnitude
            label.Text = player.Name .. " [" .. math.floor(dist) .. "m]"
            -- เปลี่ยนสีตามระยะ
            if dist < 50 then
                label.TextColor3 = Color3.fromRGB(255, 0, 0)
            elseif dist < 150 then
                label.TextColor3 = Color3.fromRGB(255, 200, 0)
            else
                label.TextColor3 = Color3.fromRGB(0, 255, 100)
            end
        end
    end)
end

