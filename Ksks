        {label = "💥 Ban All (เตะทุกคน)", action = function()
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    p:Kick("💀 Banned by CoolGUI")
                end
            end
        end},
        {label = "🌌 Skybox (เปลี่ยนท้องฟ้า)", action = function()
            local colors = {
                Color3.fromRGB(255,0,0), Color3.fromRGB(0,255,0),
                Color3.fromRGB(0,0,255), Color3.fromRGB(255,255,0),
                Color3.fromRGB(255,0,255), Color3.fromRGB(0,255,255)
            }
            Camera.BackgroundColor3 = colors[math.random(1, #colors)]
            -- ส่งผลให้ทุกคนเห็นผ่าน Fog
            local atmos = Instance.new("Atmosphere")
            atmos.Parent = workspace
            atmos.Density = 0.3
            atmos.Color = Camera.BackgroundColor3
        end},
        {label = "🗑️ Delete Killers (ลบ NPC)", action = function()
            for _, v in pairs(workspace:GetDescendants()) do
                if v:IsA("Model") and v:FindFirstChild("Humanoid") and not v:FindFirstChild("HumanoidRootPart") then
                    v:Destroy()
                end
            end
        end},
        {label = "🐢 Lag Server (สร้างวัตถุ 1000 ชิ้น)", action = function()
            for i = 1, 1000 do
                local p = Instance.new("Part")
                p.Size = Vector3.new(5,5,5)
                p.Position = Vector3.new(math.random(-500,500), math.random(5,200), math.random(-500,500))
                p.Anchored = true
                p.Transparency = 0.8
                p.BrickColor = BrickColor.Random()
                p.Parent = workspace
                if i % 50 == 0 then task.wait() end
            end
        end},
        {label = "💣 Explode Map (ระเบิดแผนที่)", action = function()
            for _, v in pairs(workspace:GetDescendants()) do
                if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" and v.Size.Magnitude < 100 then
                    local exp = Instance.new("Explosion")
                    exp.Position = v.Position
                    exp.BlastRadius = 25
                    exp.BlastPressure = 1000
                    exp.Parent = workspace
                    task.wait(0.005)
                end
            end
        end},
        {label = "☢️ Nuke Players (นิวเคลียร์ผู้เล่น)", action = function()
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local exp = Instance.new("Explosion")
                        exp.Position = hrp.Position
                        exp.BlastRadius = 60
                        exp.BlastPressure = 5000
                        exp.Parent = workspace
                    end
                end
            end
        end},
    }
    createPopup("💀 SERVER DESTRUCTION", list)
end

