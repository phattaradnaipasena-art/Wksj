-- ================================================================
--  ฟังก์ชันบิน (Fly)
-- ================================================================
local function toggleFly()
    state.Fly = not state.Fly
    btnFly.Text = state.Fly and "🟢 บิน (แตะปิด)" or "🔴 บิน (แตะเปิด)"
    flyFrame.Visible = state.Fly

    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if state.Fly then
        flyBV = Instance.new("BodyVelocity")
        flyBV.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        flyBV.Parent = hrp

        flyBG = Instance.new("BodyGyro")
        flyBG.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
        flyBG.CFrame = hrp.CFrame
        flyBG.Parent = hrp

        if flyConn then flyConn:Disconnect() end
        flyConn = RunService.Heartbeat:Connect(function()
            if not state.Fly or not hrp.Parent then return end
            local fwd = Camera.CFrame.LookVector
            local right = Camera.CFrame.RightVector
            local up = Camera.CFrame.UpVector
            local mv = Vector3.new()
            if flyVars.F then mv = mv + fwd end
            if flyVars.B then mv = mv - fwd end
            if flyVars.L then mv = mv - right end
            if flyVars.R then mv = mv + right end
            if flyVars.U then mv = mv + up end
            if flyVars.D then mv = mv - up end
            if mv.Magnitude > 0 then
                flyBV.Velocity = mv.Unit * 65
            else
                flyBV.Velocity = Vector3.new(0,0,0)
            end
            flyBG.CFrame = CFrame.new(hrp.Position, hrp.Position + fwd)
        end)
    else
        if flyConn then flyConn:Disconnect(); flyConn = nil end
        if flyBV then flyBV:Destroy(); flyBV = nil end
        if flyBG then flyBG:Destroy(); flyBG = nil end
        for k in pairs(flyVars) do flyVars[k] = false end
    end
end

-- ================================================================
--  ฟังก์ชัน Noclip (ทะลุกำแพง)
-- ================================================================
local function toggleNoclip()
    state.Noclip = not state.Noclip
    btnNoclip.Text = state.Noclip and "🟢 ทะลุ (แตะปิด)" or "🔴 ทะลุ (แตะเปิด)"
    local char = LocalPlayer.Character
    if not char then return end
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not state.Noclip
        end
    end
end

-- รีเซ็ต Noclip เมื่อเกิดใหม่
LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    if state.Noclip then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end
    local hum = char:FindFirstChild("Humanoid")
    if hum then
        hum.WalkSpeed = state.Speed
        hum.JumpPower = state.Jump
    end
end)

