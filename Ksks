                p.Parent = workspace
                if i % 200 == 0 then task.wait() end
            end
        end},
        {label = "❤️ Revive (ฟื้นตัวเอง)", action = function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid.Health = char.Humanoid.MaxHealth
            end
        end},
        {label = "🧊 Freeze Player (หยุดทุกคน)", action = function()
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Humanoid") then
                    p.Character.Humanoid.PlatformStand = true
                    p.Character.Humanoid.WalkSpeed = 0
                end
            end
        end},
        {label = "🔫 Rifle (ปืนไรเฟิล)", action = function()
            local tool = Instance.new("Tool")
            tool.Name = "CoolRifle"
            tool.RequiresHandle = false
            tool.Parent = LocalPlayer.Backpack
            local handle = Instance.new("Part")
            handle.Size = Vector3.new(0.5, 0.2, 1.5)
            handle.BrickColor = BrickColor.new("Really black")
            handle.Parent = tool
            tool.Handle = handle
        end},
        {label = "🪐 Gravity Gun (ปืนแรงโน้มถ่วง)", action = function()
            state.GravityGun = not state.GravityGun
            if state.GravityGun then
                RunService.Heartbeat:Connect(function()
                    if not state.GravityGun then return end
                    local mouse = UserInputService:GetMouseLocation()
                    local target = Camera:ScreenToWorldPoint(Vector3.new(mouse.X, mouse.Y, 100))
                    for _, p in pairs(workspace:GetDescendants()) do
                        if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" and p.Name ~= "Head" then
                            local dist = (p.Position - target).Magnitude
                            if dist < 30 then
                                p.Velocity = (p.Position - target).Unit * 70
                            end
                        end
                    end
                end)
            end
        end},
    }
    createPopup("👑 ADMIN COMMANDS", list)
end

