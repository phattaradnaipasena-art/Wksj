            local char = LocalPlayer.Character
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid.WalkSpeed = 100
            end
        end},
        {label = "👾 Summon 10,000 (เรียกวัตถุ)", action = function()
            for i = 1, 10000 do
                local p = Instance.new("Part")
                p.Size = Vector3.new(1,1,1)
